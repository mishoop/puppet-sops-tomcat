# Role-specific secrets for Tomcat servers
# Encrypt with: sops --encrypt --in-place <filename>

# Session encryption key
profile_tomcat::session_secret: "random-session-secret-key-here"

# Connection pool settings with credentials
profile_tomcat::datasource_config:
  username: "webapp"
  password: "WebAppSecurePass456!"
  validation_query: "SELECT 1"
  max_active: 100
  max_idle: 30
  min_idle: 10
