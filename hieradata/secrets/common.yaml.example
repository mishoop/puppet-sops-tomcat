# Example secrets file - NOT encrypted
# To encrypt this file:
#   1. Copy to common.yaml
#   2. Update .sops.yaml with your age public key
#   3. Run: sops --encrypt --in-place environments/production/hieradata/secrets/common.yaml
#
# To edit after encryption:
#   sops environments/production/hieradata/secrets/common.yaml

# Database credentials for Tomcat context.xml
profile_tomcat::db_username: "appuser"
profile_tomcat::db_password: "SuperSecretPassword123!"
profile_tomcat::db_url: "jdbc:mysql://db.internal:3306/myapp"

# API keys
profile_tomcat::api_key: "sk-1234567890abcdef"
profile_tomcat::api_secret: "secret-abcdefghijklmnop"

# SSL keystore password
profile_tomcat::keystore_password: "changeit"
